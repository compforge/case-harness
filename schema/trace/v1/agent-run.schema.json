{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compforge.dev/schema/trace/v1/agent-run.schema.json",
  "title": "Trace Harness AgentRun IR",
  "type": "object",
  "required": ["schema", "trace_id", "runs"],
  "properties": {
    "schema": {"const": "trace-harness/agent-run@1"},
    "trace_id": {"type": "string"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/agent_run"}}
  },
  "additionalProperties": false,
  "$defs": {
    "source_node_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "attributes": {"type": "object", "additionalProperties": true},
    "model_call": {
      "type": "object",
      "required": [
        "kind", "id", "name", "start_ms", "duration_ms", "status", "input", "output",
        "attributes", "source_node_ids", "model"
      ],
      "properties": {
        "kind": {"const": "model-call"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "status": {"type": "string"},
        "input": {},
        "output": {},
        "attributes": {"$ref": "#/$defs/attributes"},
        "source_node_ids": {"$ref": "#/$defs/source_node_ids"},
        "model": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "required": [
        "kind", "id", "name", "start_ms", "duration_ms", "status", "input", "output",
        "attributes", "source_node_ids", "tool_call_id"
      ],
      "properties": {
        "kind": {"const": "tool-call"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "status": {"type": "string"},
        "input": {},
        "output": {},
        "attributes": {"$ref": "#/$defs/attributes"},
        "source_node_ids": {"$ref": "#/$defs/source_node_ids"},
        "tool_call_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "kind", "id", "name", "start_ms", "duration_ms", "status", "input", "output",
        "attributes", "source_node_ids"
      ],
      "properties": {
        "kind": {"const": "operation"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "status": {"type": "string"},
        "input": {},
        "output": {},
        "attributes": {"$ref": "#/$defs/attributes"},
        "source_node_ids": {"$ref": "#/$defs/source_node_ids"}
      },
      "additionalProperties": false
    },
    "turn_item": {
      "oneOf": [
        {"$ref": "#/$defs/model_call"},
        {"$ref": "#/$defs/tool_call"},
        {"$ref": "#/$defs/operation"}
      ]
    },
    "agent_turn": {
      "type": "object",
      "required": [
        "kind", "id", "name", "start_ms", "duration_ms", "status", "attributes",
        "source_node_ids", "items"
      ],
      "properties": {
        "kind": {"const": "agent-turn"},
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "status": {"type": "string"},
        "attributes": {"$ref": "#/$defs/attributes"},
        "source_node_ids": {"$ref": "#/$defs/source_node_ids"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/turn_item"}}
      },
      "additionalProperties": false
    },
    "agent_run_item": {
      "oneOf": [
        {"$ref": "#/$defs/agent_turn"},
        {"$ref": "#/$defs/operation"}
      ]
    },
    "agent_run": {
      "type": "object",
      "required": [
        "id", "name", "start_ms", "duration_ms", "status", "attributes",
        "source_node_ids", "items"
      ],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "status": {"type": "string"},
        "attributes": {"$ref": "#/$defs/attributes"},
        "source_node_ids": {"$ref": "#/$defs/source_node_ids"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/agent_run_item"}}
      },
      "additionalProperties": false
    }
  }
}
