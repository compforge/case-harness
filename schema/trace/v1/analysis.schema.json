{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compforge.dev/schema/trace/v1/analysis.schema.json",
  "title": "Trace Harness analysis IR",
  "type": "object",
  "required": ["schema", "trace_id", "span_count", "nodes", "findings"],
  "properties": {
    "schema": {"const": "trace-harness/analysis@1"},
    "trace_id": {"type": "string"},
    "span_count": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["label", "value", "emphasis"],
      "properties": {
        "label": {"type": "string"},
        "value": {"type": "string"},
        "emphasis": {"enum": ["normal", "dim", "strong"]}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "parent_node_id",
        "kind",
        "name",
        "start_ms",
        "duration_ms",
        "service",
        "primary_span_id",
        "span_ids",
        "error_span_ids",
        "error_text",
        "facts",
        "brief"
      ],
      "properties": {
        "node_id": {"type": "string"},
        "parent_node_id": {"type": ["string", "null"]},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "start_ms": {"type": "number"},
        "duration_ms": {"type": "number", "minimum": 0},
        "service": {"type": ["string", "null"]},
        "primary_span_id": {"type": "string"},
        "span_ids": {"type": "array", "items": {"type": "string"}},
        "error_span_ids": {"type": "array", "items": {"type": "string"}},
        "error_text": {"type": "string"},
        "facts": {"type": "object", "additionalProperties": true},
        "brief": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "ref",
        "source",
        "severity",
        "scope",
        "rank",
        "note",
        "data",
        "symptoms",
        "causes"
      ],
      "properties": {
        "ref": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "severity": {"enum": ["info", "warn", "error"]},
        "scope": {"enum": ["node", "trace", "cohort"]},
        "rank": {"type": ["integer", "number", "null"]},
        "note": {"type": "string"},
        "data": {"type": "object", "additionalProperties": true},
        "symptoms": {"type": "array", "items": {"type": "string"}},
        "causes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
